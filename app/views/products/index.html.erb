<h1>Products</h1>

<div class="products-layout" data-controller="product-search">
  <aside class="filters">
    <%= form_with url: products_path, method: :get, class: "filters__form",
          data: { product_search_target: "form", turbo_frame: "products-results", turbo_action: "advance" } do %>
      <div class="field search-field">
        <label for="q" class="sr-only">Search products</label>
        <div class="search-field__input-wrapper">
          <%= search_field_tag :q, @query, placeholder: "Search by name, brand, model, or SKU…",
                autocomplete: "off", autocorrect: "off", spellcheck: "false",
                data: { product_search_target: "input", action: "input->product-search#onInput" } %>
          <button type="button" class="search-field__clear" data-product-search-target="clear"
                  data-action="click->product-search#clear" hidden aria-label="Clear search">&times;</button>
        </div>
      </div>
      <fieldset>
        <legend>Price</legend>
        <label>Min <%= number_field_tag :min_price, params[:min_price], step: "0.01", min: 0 %></label>
        <label>Max <%= number_field_tag :max_price, params[:max_price], step: "0.01", min: 0 %></label>
      </fieldset>
      <fieldset>
        <legend>Availability</legend>
        <label>
          <%= check_box_tag :in_stock, "1", params[:in_stock] == "1" %>
          In stock only
        </label>
      </fieldset>
      <div class="field">
        <label for="sort">Sort by</label>
        <%= select_tag :sort, options_for_select(
              [["Relevance", ""], ["Name (A-Z)", "name_asc"], ["Name (Z-A)", "name_desc"],
               ["Price (low to high)", "price_asc"], ["Price (high to low)", "price_desc"]],
              params[:sort]) %>
      </div>
      <%= submit_tag "Filter", class: "btn btn--primary" %>
    <% end %>
  </aside>

  <section>
    <div class="sr-only" aria-live="polite" data-product-search-target="status"></div>
    <p class="search-error" data-product-search-target="error" hidden>
      Couldn't reach the server. Check your connection and try again.
    </p>

    <%= turbo_frame_tag "products-results", data: { turbo_action: "advance", product_search_target: "frame" } do %>
      <%= render "products/results", products: @products, favorited_product_ids: @favorited_product_ids, query: @query %>
    <% end %>
  </section>
</div>
