<% if user_signed_in? %>
  <div data-controller="product-view-tracker"
       data-product-view-tracker-url-value="<%= product_product_view_path(@product) %>"
       hidden></div>
<% end %>

<div class="product-detail">
  <% if @product.image.attached? %>
    <%= image_tag @product.image, class: "product-detail__image" %>
  <% end %>

  <div class="product-detail__info">
    <div class="product-detail__heading">
      <h1><%= @product.name %></h1>
      <div class="product-detail__toggles">
        <%= render "favorites/favorite_button", product: @product, favorited: @favorited_product_ids.include?(@product.id) %>
        <%= render "products/compare_toggle", product: @product %>
      </div>
    </div>
    <p class="product-detail__meta">
      <%= @product.brand %><%= " #{@product.model}" if @product.model.present? %>
      &middot; <%= @product.category_label %>
      &middot; SKU <%= @product.sku %>
    </p>

    <p class="product-detail__price">
      ₴<%= number_with_precision(@product.price_cents / 100.0, precision: 2) %>
      <% if @product.discounted? %>
        <span class="product-detail__previous-price">₴<%= number_with_precision(@product.previous_price_cents / 100.0, precision: 2) %></span>
      <% end %>
    </p>
    <p><%= @product.description %></p>
    <p class="product-detail__availability">
      <% if @product.out_of_stock? %>
        Out of stock
      <% elsif @product.low_stock? %>
        Only <%= @product.stock_quantity %> left in stock
      <% else %>
        <%= @product.stock_quantity %> in stock
      <% end %>
    </p>

    <ul class="product-detail__facts">
      <% if @product.color.present? %>
        <li><strong>Color:</strong> <%= @product.color %></li>
      <% end %>
      <% if @product.weight_grams.present? %>
        <li><strong>Weight:</strong> <%= @product.weight_grams %> g</li>
      <% end %>
      <% if @product.warranty_months.present? %>
        <li><strong>Warranty:</strong> <%= pluralize(@product.warranty_months, "month") %></li>
      <% end %>
    </ul>

    <% if @product.specifications.present? %>
      <div class="product-detail__specifications">
        <h2>Specifications</h2>
        <dl>
          <% @product.specifications.each do |key, value| %>
            <dt><%= @product.specification_label(key.to_s) %></dt>
            <dd><%= value.is_a?(Array) ? value.join(", ") : value %></dd>
          <% end %>
        </dl>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <%= form_with url: cart_items_path, method: :post, class: "add-to-cart-form" do %>
        <%= hidden_field_tag :product_id, @product.id %>
        <%= number_field_tag :quantity, 1, min: 1, class: "quantity-input" %>
        <%= submit_tag "Add to Cart", class: "btn btn--accent" %>
      <% end %>
    <% else %>
      <%= link_to "Sign in to purchase", new_user_session_path, class: "btn btn--primary" %>
    <% end %>

    <% if user_signed_in? && current_user.admin? %>
      <div class="admin-actions">
        <%= link_to "Edit", edit_product_path(@product), class: "btn btn--secondary" %>
        <%= button_to "Delete", product_path(@product), method: :delete, class: "btn btn--danger",
              form: { data: { turbo_confirm: "Delete this product?" } } %>
      </div>
    <% end %>
  </div>
</div>
